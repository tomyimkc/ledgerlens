# Copy to deploy/judge.env on the VM (or provide the same names as environment
# variables / GitHub Environment secrets). Never commit real values.

# Public DNS names. Create A/AAAA records to the VM before running deploy/bin/up.sh.
LEDGERLENS_FQDN=ledgerlens.example.org
DATAHUB_FQDN=datahub.example.org
CADDY_ACME_EMAIL=operator@example.org

# Caddy perimeter credential shared with judges. Generate the hash with:
#   docker run --rm caddy:2.10.2-alpine caddy hash-password --plaintext 'strong-password'
JUDGE_GATEWAY_USERNAME=judge
JUDGE_GATEWAY_PASSWORD=replace-with-a-random-password
JUDGE_GATEWAY_PASSWORD_HASH='$2a$14$replace-with-caddy-bcrypt-hash'

# DataHub native credentials. The root username must remain "datahub" because
# DataHub grants that URN immutable bootstrap privileges; only rotate its password.
DATAHUB_ADMIN_USERNAME=datahub
DATAHUB_ADMIN_PASSWORD=replace-with-a-private-random-password
DATAHUB_JUDGE_USERNAME=ledgerlens-judge
DATAHUB_JUDGE_PASSWORD=replace-with-a-random-password
DATAHUB_SERVICE_USERNAME=ledgerlens-service
DATAHUB_SERVICE_PASSWORD=replace-with-a-private-random-password

# Pinned software and official quickstart compose integrity.
DATAHUB_VERSION=v1.6.0
DATAHUB_CLI_VERSION=1.6.0.16
DATAHUB_QUICKSTART_COMPOSE_SHA256=ba39d779cd0e066553b5f4673384ece3d6a872e2245983525fc71e2ece1b5077
CADDY_IMAGE=caddy:2.10.2-alpine

# Host-only diagnostic ports. The generated DataHub compose binds every
# quickstart port to 127.0.0.1; only Caddy publishes 80/443.
DATAHUB_MAPPED_GMS_PORT=8080
DATAHUB_MAPPED_FRONTEND_PORT=9002
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443

# Cost ceiling. The host-side watchdog stops the stack when this TTL expires.
JUDGE_TTL_HOURS=24

# Safe application defaults. Hosted judging does not require a paid LLM.
LEDGERLENS_LLM_ENABLED=false
LEDGERLENS_MUTATIONS_ENABLED=false
