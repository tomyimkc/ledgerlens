# DataHub OSS
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_FRONTEND_URL=http://localhost:9002
DATAHUB_GMS_TOKEN=

# Official DataHub MCP server
DATAHUB_MCP_COMMAND=mcp-server-datahub
DATAHUB_MCP_URL=

# ---- LLM (OpenAI and/or Anthropic native) ----
# Prefer provider-native keys. Never commit real secrets.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional generic fallback used when the provider-specific key is unset:
# LEDGERLENS_LLM_API_KEY=

# openai | anthropic | openai_compatible
LEDGERLENS_LLM_PROVIDER=openai
LEDGERLENS_LLM_BASE_URL=https://api.openai.com/v1
LEDGERLENS_LLM_MODEL=gpt-4o

# Planner / verifiers (can mix providers)
LEDGERLENS_PLANNER_MODEL=gpt-4o
# LEDGERLENS_PLANNER_PROVIDER=openai
LEDGERLENS_VERIFIER_MODELS=gpt-4o-mini,gpt-4-turbo
# LEDGERLENS_VERIFIER_PROVIDER=openai
# Example Anthropic pair:
# LEDGERLENS_LLM_PROVIDER=anthropic
# LEDGERLENS_PLANNER_MODEL=claude-sonnet-4-20250514
# LEDGERLENS_VERIFIER_MODELS=claude-3-5-haiku-latest,claude-sonnet-4-20250514

# Safe defaults
LEDGERLENS_LLM_ENABLED=false
LEDGERLENS_MUTATIONS_ENABLED=false
LEDGERLENS_AI_VERIFICATION_ENABLED=false
